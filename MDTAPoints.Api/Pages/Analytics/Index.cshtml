@page
@model MDTAPoints.Api.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analytics";
}

<div class="table-head">
    <h1>Analytics</h1>
    <div class="table-tools">
        <a class="excel" asp-page="/Analytics/Index" asp-page-handler="Export" asp-route-divisions="@(Model.AllDivisions ? "all" : null)" title="Download Excel" aria-label="Download analytics as Excel">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                <rect width="24" height="24" rx="4" fill="#217346" />
                <path fill="#fff" d="M6.6 6.4h3.2l2.2 3.5 2.2-3.5h3.2L13.4 12l4.1 5.6h-3.3l-2.2-3.4-2.2 3.4H6.5L10.6 12z" />
            </svg>
        </a>
    </div>
</div>
<nav class="filters">
    <a class="@(!Model.AllDivisions ? "current" : null)" asp-page="/Analytics/Index">Varsity only</a>
    <a class="@(Model.AllDivisions ? "current" : null)" asp-page="/Analytics/Index" asp-route-divisions="all">All divisions</a>
</nav>
<p class="muted">Published tournaments, @(Model.AllDivisions ? "varsity, JV, and novice" : "varsity and open divisions"). Lincoln-Douglas and Congressional Debate count each student once. Classic, Public Forum, and Policy count each entry once, so a team that stays together is one entry across the season. A school total adds those counts. Schools removed from stats are left out. Standings stay varsity only.</p>

<h2>By event</h2>
<table>
    <thead>
        <tr><th>Event</th><th class="num">Schools</th><th class="num">Count</th><th>Counted as</th></tr>
    </thead>
    <tbody>
    @foreach (var row in Model.Report.Events)
    {
        <tr>
            <td>@EventKindLabels.Display(row.Event)</td>
            <td class="num">@row.SchoolCount</td>
            <td class="num">@row.Count</td>
            <td>@ParticipationAnalytics.CountLabel(row.CountEntries)</td>
        </tr>
    }
    </tbody>
</table>

<div class="table-head">
    <h2>By school</h2>
    <div class="table-tools">
        <input type="search" data-filter="schools" placeholder="School" aria-label="Search schools" />
    </div>
</div>
<table data-table="schools">
    <thead>
        <tr>
            <th>School</th>
            @foreach (var kind in ParticipationAnalytics.EventOrder)
            {
                <th class="num" title="@EventKindLabels.Display(kind)">@EventKindLabels.Short(kind)</th>
            }
            <th class="num">Total</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var school in Model.Report.Schools)
    {
        <tr data-search="@school.SchoolName">
            <td>@school.SchoolName</td>
            @foreach (var kind in ParticipationAnalytics.EventOrder)
            {
                <td class="num">@school.Counts[kind]</td>
            }
            <td class="num">@school.Total</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr>
            <th>@ParticipationAnalytics.SchoolsAndStudents(Model.Report.Schools.Count, Model.Report.StudentCount)</th>
            @foreach (var kind in ParticipationAnalytics.EventOrder)
            {
                <td class="num">@Model.Report.Schools.Sum(school => school.Counts[kind])</td>
            }
            <td class="num">@Model.Report.Schools.Sum(school => school.Total)</td>
        </tr>
    </tfoot>
</table>
<p class="muted">The school total is each kid once, including both partners on a team. Classic, Public Forum, and Policy stay entries, so a team counts as one in those columns.</p>
@if (Model.Report.Schools.Count == 0)
{
    <p class="muted">No published results yet.</p>
}
<p class="muted filter-empty" data-empty="schools" hidden>No matching schools.</p>

<h2>Average entries per weekend</h2>
<p class="muted">Published tournaments in the same week are added together, so Lincoln-Douglas at Rosemount and Coon Rapids is one weekend field. Novice matches novice and JV matches JV. A tournament with no JV division counts the next division up, so Open counts as varsity. Each entry counts once, including a two-person team. The average uses only weekends when that division was offered. This section always includes novice, JV, and varsity. Schools removed from stats are left out.</p>
@if (Model.Weekends.Weekends.Count == 0)
{
    <p class="muted">No published results yet.</p>
}
else
{
    <div class="chart-scroll">
        <ul class="legend">
            <li><i class="novice"></i> Novice</li>
            <li><i class="jv"></i> JV</li>
            <li><i class="varsity"></i> Varsity</li>
        </ul>
        @Html.Raw(Model.ChartSvg)
    </div>
    <table>
        <thead>
            <tr>
                <th>Event</th>
                @foreach (var division in WeekendFieldAnalytics.DivisionOrder)
                {
                    <th class="num">@WeekendFieldAnalytics.DivisionLabel(division)</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var kind in ParticipationAnalytics.EventOrder)
        {
            <tr>
                <td>@EventKindLabels.Display(kind)</td>
                @foreach (var division in WeekendFieldAnalytics.DivisionOrder)
                {
                    var average = Model.Weekends.Average(kind, division);
                    <td class="num">
                        @WeekendFieldAnalytics.FormatAverage(average.Average)
                        @if (average.Weekends > 0)
                        {
                            <span class="sub">@average.Weekends @(average.Weekends == 1 ? "weekend" : "weekends")</span>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>

    <h2>Each weekend</h2>
    <p class="muted">Combined entries at every site that week. A blank cell means that division was not offered.</p>
    <div class="scroll-x">
        <table>
            <thead>
                <tr>
                    <th rowspan="2">Weekend</th>
                    <th rowspan="2">Sites</th>
                    @foreach (var kind in ParticipationAnalytics.EventOrder)
                    {
                        <th class="group split" colspan="3" title="@EventKindLabels.Display(kind)">@EventKindLabels.Short(kind)</th>
                    }
                </tr>
                <tr>
                    @foreach (var kind in ParticipationAnalytics.EventOrder)
                    {
                        <th class="num split" title="@EventKindLabels.Display(kind)">Novice</th>
                        <th class="num">JV</th>
                        <th class="num">Varsity</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var weekend in Model.Weekends.Weekends)
            {
                <tr>
                    <td class="nowrap">@weekend.Dates</td>
                    <td>@string.Join(", ", weekend.Tournaments)</td>
                    @foreach (var kind in ParticipationAnalytics.EventOrder)
                    {
                        @for (var index = 0; index < WeekendFieldAnalytics.DivisionOrder.Length; index++)
                        {
                            var count = weekend.Count(kind, WeekendFieldAnalytics.DivisionOrder[index]);
                            <td class="num@(index == 0 ? " split" : "")">@(count == 0 ? "" : count.ToString())</td>
                        }
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<script>
    document.querySelectorAll("[data-filter]").forEach(function (input) {
        var table = document.querySelector('table[data-table="' + input.dataset.filter + '"]');
        var empty = document.querySelector('[data-empty="' + input.dataset.filter + '"]');
        if (!table || !table.tBodies[0]) {
            return;
        }
        var rows = Array.prototype.slice.call(table.tBodies[0].rows);
        input.addEventListener("input", function () {
            var terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
            var shown = 0;
            rows.forEach(function (row) {
                var haystack = (row.dataset.search || "").toLowerCase();
                var match = terms.every(function (term) { return haystack.indexOf(term) !== -1; });
                row.hidden = !match;
                if (match) {
                    shown++;
                }
            });
            if (empty) {
                empty.hidden = terms.length === 0 || shown > 0;
            }
        });
    });
</script>
