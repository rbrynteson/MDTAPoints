@page
@model MDTAPoints.Api.Pages.IndexModel
@{
    ViewData["Title"] = "Standings";
    var events = new[]
    {
        EventKind.LincolnDouglas,
        EventKind.Classic,
        EventKind.PublicForum,
        EventKind.Policy,
        EventKind.Congress
    };
    var eventName = EventKindLabels.Display(Model.Event);
}

<h1>MDTA Cup standings</h1>
<p class="muted">Award eligibility requires four in-state invitationals. A student keeps the higher result when two tournaments fall in the same week. Each event has its own team award.</p>

<nav class="filters">
    @foreach (var kind in events)
    {
        <a class="@(kind == Model.Event ? "current" : null)" asp-page="/Index" asp-route-event="@kind">@EventKindLabels.Display(kind)</a>
    }
</nav>

<div class="table-head">
    <h2>@eventName individuals</h2>
    <div class="table-tools">
        <input type="search" data-filter="individuals" placeholder="Student or school" aria-label="Search individuals by student or school" />
        <a class="excel" asp-page="/Index" asp-page-handler="Export" asp-route-event="@Model.Event" asp-route-table="individuals" title="Download Excel" aria-label="Download @eventName individuals as Excel">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                <rect width="24" height="24" rx="4" fill="#217346" />
                <path fill="#fff" d="M6.6 6.4h3.2l2.2 3.5 2.2-3.5h3.2L13.4 12l4.1 5.6h-3.3l-2.2-3.4-2.2 3.4H6.5L10.6 12z" />
            </svg>
        </a>
    </div>
</div>
<table data-table="individuals">
    <thead>
        <tr><th>Award</th><th>Student</th><th>School</th><th>Points</th><th>Tournaments</th><th>Breakdown</th></tr>
    </thead>
    <tbody>
    @foreach (var student in Model.Individuals)
    {
        <tr data-search="@student.Name @student.SchoolName">
            <td>@(student.Eligible ? student.AwardRank?.ToString() : "Not eligible")</td>
            <td>@student.Name</td>
            <td>@student.SchoolName</td>
            <td>@student.Points</td>
            <td>@student.TournamentCount</td>
            <td>
                @foreach (var line in student.Lines)
                {
                    <div class="@(line.Dropped ? "dropped" : "")">@(line.Dropped ? "Dropped" : line.Detail): @line.TournamentName (@line.Points)</div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<p class="muted filter-empty" data-empty="individuals" hidden>No matching students or schools.</p>

<div class="table-head">
    <h2>@eventName teams</h2>
    <div class="table-tools">
        <input type="search" data-filter="teams" placeholder="School" aria-label="Search teams by school" />
        <a class="excel" asp-page="/Index" asp-page-handler="Export" asp-route-event="@Model.Event" asp-route-table="teams" title="Download Excel" aria-label="Download @eventName teams as Excel">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                <rect width="24" height="24" rx="4" fill="#217346" />
                <path fill="#fff" d="M6.6 6.4h3.2l2.2 3.5 2.2-3.5h3.2L13.4 12l4.1 5.6h-3.3l-2.2-3.4-2.2 3.4H6.5L10.6 12z" />
            </svg>
        </a>
    </div>
</div>
<p class="muted">First place is the team award for this event.</p>
<table data-table="teams">
    <thead>
        <tr><th>Place</th><th>School</th><th>Points</th><th>Tournaments</th><th>Breakdown</th></tr>
    </thead>
    <tbody>
    @foreach (var school in Model.Teams)
    {
        <tr data-search="@school.SchoolName">
            <td>@school.Rank</td>
            <td>@school.SchoolName</td>
            <td>@school.Points</td>
            <td>@school.TournamentCount</td>
            <td>
                @foreach (var line in school.Lines)
                {
                    <div class="@(line.Dropped ? "dropped" : "")">@(line.Dropped ? "Dropped" : "Kept"): @line.TournamentName, @line.Points pts</div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<p class="muted filter-empty" data-empty="teams" hidden>No matching schools.</p>

<script>
    document.querySelectorAll("[data-filter]").forEach(function (input) {
        var table = document.querySelector('table[data-table="' + input.dataset.filter + '"]');
        var empty = document.querySelector('[data-empty="' + input.dataset.filter + '"]');
        var rows = Array.prototype.slice.call(table.tBodies[0].rows);
        input.addEventListener("input", function () {
            var terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
            var shown = 0;
            rows.forEach(function (row) {
                var haystack = (row.dataset.search || "").toLowerCase();
                var match = terms.every(function (term) { return haystack.indexOf(term) !== -1; });
                row.hidden = !match;
                if (match) {
                    shown++;
                }
            });
            if (empty) {
                empty.hidden = terms.length === 0 || shown > 0;
            }
        });
    });
</script>
