@page
@model MDTAPoints.Api.Pages.Admin.Tournaments.IndexModel
@{
    ViewData["Title"] = "Tournaments";
}

<h1>Tournaments</h1>
<p>
    <a class="button" asp-page="Import">Import from Tabroom</a>
    <a class="button" asp-page="Create">Add a tournament</a>
</p>
@if (!string.IsNullOrEmpty(Model.Message))
{
    <p>@Model.Message</p>
}
<table>
    <thead>
        <tr><th>Date</th><th>Name</th><th>Type</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var tournament in Model.Tournaments)
    {
        <tr>
            <td>@tournament.StartDate.ToString("yyyy-MM-dd")</td>
            <td>@tournament.Name</td>
            <td>@tournament.Kind</td>
            <td>@tournament.Status</td>
            <td><a asp-page="Review" asp-route-id="@tournament.Id">Review</a></td>
        </tr>
    }
    </tbody>
</table>
