@page
@model MDTAPoints.Api.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="error">@Model.Error</p>
}
<form method="post" class="stack">
    <label>Username <input asp-for="Username" required /></label>
    <label>Display name <input asp-for="DisplayName" required /></label>
    <label>Password <input asp-for="Password" type="password" required /></label>
    <button type="submit">Add user</button>
</form>
<table>
    <thead>
        <tr><th>Name</th><th>Username</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.DisplayName</td>
            <td>@user.Username</td>
            <td>
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="id" value="@user.Id" />
                    <button type="submit">Remove</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
